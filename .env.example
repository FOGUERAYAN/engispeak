# ---- Général ----
APP_ENV=local                 # local | dev | prod
LOG_LEVEL=INFO

# ---- Stockage 1 : progression ----
# sql (SQLite / PostgreSQL) ou azure_table
PROGRESS_BACKEND=sql
# Laisser vide en local => SQLite (./data/engispeak.db).
# En prod, préférer KEY_VAULT_URL + secret "database-url" plutôt qu'une valeur en clair.
DATABASE_URL=
# Uniquement si PROGRESS_BACKEND=azure_table (auth Managed Identity)
AZURE_TABLE_ENDPOINT=         # ex. https://<compte>.table.core.windows.net
AZURE_TABLE_NAME=progress

# ---- Stockage 2 : ressources de cours (Azure Blob) ----
# Vide => fallback sur le dossier LOCAL_RESOURCES_DIR
AZURE_STORAGE_ACCOUNT_URL=    # ex. https://<compte>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=resources
LOCAL_RESOURCES_DIR=./resources

# ---- Secrets ----
KEY_VAULT_URL=                # ex. https://<vault>.vault.azure.net
DATABASE_URL_SECRET_NAME=database-url
# Managed Identity user-assigned (optionnel) : DefaultAzureCredential la lit automatiquement
AZURE_CLIENT_ID=

# ---- Worker ----
WORKER_INTERVAL_SECONDS=86400 # 1 rappel par jour
WORKER_RUN_ONCE=false         # true pour un usage en tâche planifiée (cron / Container Apps Job)
INACTIVITY_DAYS_THRESHOLD=2

# ---- docker-compose (PostgreSQL local uniquement) ----
POSTGRES_USER=engispeak
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=engispeak
